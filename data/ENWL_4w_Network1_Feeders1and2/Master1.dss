! Original network data and time series from ENWL - Low Voltage Network Solutions project (in OpenDSS format)
!   https://www.enwl.co.uk/go-net-zero/innovation/smaller-projects/low-carbon-networks-fund/low-voltage-network-solutions/

! Adapted with length-normalized four-wire impedance data from: 
!   Urquhart, Andrew J., and Murray Thomson. 2019. “Cable Impedance Data”. figshare. https://hdl.handle.net/2134/15544.
!   Creative Commons Attribution-NonCommercial 3.0 Unported License.

! Adaptation process described in  
!   'Distribution Network Modeling: From Simulation Towards Optimization, Sander Claeys, Phd Dissertation, KU Leuven, Belgium 2021

! Impedance transformations described in 
!   'Computational Analysis of Impedance Transformations for Four-Wire Power Networks with Sparse Neutral Grounding', Frederik Geth, Rahmat Heidarihaei, Arpan Koirala, submitted to ACM E-energy 2022.

Clear
Set DefaultBaseFreq=50
New Circuit.ENWL_network_1_Feeder2_1and2_4wire BasekV=11 pu=1.00 ISC3=100000 ISC1=100000
New Reactor.Grounding phases=1 bus1=sourcebus.4 bus2=sourcebus.0 R=0.0 X=1E-10

new line.sourceZ bus1=SourceBus bus2=SourceBusZ phases=4 R1=0.51344 X1=2.0537 R0=1.0729 X0=3.2186

! 11/416 V for +4% voltage boost
New Transformer.TR1 Buses=[SourceBusZ F1_1] Conns=[Delta Wye] kVs=[11 0.4] kVAs=[150 150] XHL=6 sub=y %R=0.0
New Reactor.Grounding1 phases=1 bus1=F1_1.4 bus2=F1_1.0 R=0.0 X=1E-10


Redirect LineCode.txt

Redirect Lines1.txt

Redirect Loads1_uniform.txt


New line.switch_1 phases=4 bus1=F1_882.1.2.3.4 bus2=F1_883.1.2.3.4 sw=True


/*
! put in the induction motors
edit load.load_1_28 bus1=F1_556.1.4 kw=4 pf=0.85
edit load.load_1_13 bus1=F1_276.1.4 kw=4 pf=0.85
edit load.load_1_53 bus1=F1_899.1.4 kw=8 pf=0.85

new load.load_1_28b bus1=F1_556.2.4 phases=1 kv=0.2309 kw=4 pf=0.85
new load.load_1_13b bus1=F1_276.2.4 phases=1 kv=0.2309 kw=4 pf=0.85
new load.load_1_53b bus1=F1_899.2.4 phases=1 kv=0.2309 kw=8 pf=0.85

new load.load_1_28c bus1=F1_556.3.4 phases=1 kv=0.2309 kw=4 pf=0.85
new load.load_1_13c bus1=F1_276.3.4 phases=1 kv=0.2309 kw=4 pf=0.85
new load.load_1_53c bus1=F1_899.3.4 phases=1 kv=0.2309 kw=8 pf=0.85
*/

new load.F1_load_sop1 phases=1 bus1=F1_882.1.4 kv=0.2309 kw=0.001 kvar=0.0 model=5
new load.F1_load_sop2 phases=1 bus1=F1_882.2.4 kv=0.2309 kw=0.001 kvar=0.0 model=5
new load.F1_load_sop3 phases=1 bus1=F1_882.3.4 kv=0.2309 kw=0.001 kvar=0.0 model=5


New Energymeter.substation Element=Line.F1_LINE1 1

Set mode=Snap
Solve
Closedi